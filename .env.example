# Rempli automatiquement par Vercel quand tu connectes une base Postgres au projet
# (voir README.md). En local, remplace par ta propre base Postgres.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Mot de passe pour accéder à /admin (choisis une chaîne longue et aléatoire)
ADMIN_TOKEN="change-moi"
